        "format": "<div style=\"width:100%; padding:6px 0;\">\n    <div style=\"text-align:center; font-weight:bold;\">pH del agua</div>\n    <div style=\"text-align:center; font-size:28px; font-weight:bold;\">\n        {{msg.payload | number:2}}\n    </div>\n\n    <div style=\"position:relative; margin:14px 8px 4px 8px;\">\n        <div style=\"height:34px; border-radius:6px;\n      background:linear-gradient(to right,\n        #e8312f 0%, #f47a20 14%, #f9a11b 21%, #fbc918 28%,\n        #d4d227 36%, #7dc242 43%, #2fb34a 50%, #17a7a0 57%,\n        #1792d0 64%, #2f6fc2 71%, #3f55b5 79%, #5a45a8 86%, #7d3a96 100%);\"></div>\n\n        <div ng-show=\"msg.payload !== undefined\"\n            ng-style=\"{left: ((msg.payload > 14 ? 14 : (msg.payload < 0 ? 0 : msg.payload)) * 100 / 14) + '%'}\" style=\"position:absolute; top:-8px; width:4px; height:50px;\n                margin-left:-2px; background:#000; border-radius:2px;\"></div>\n    </div>\n\n    <div style=\"display:flex; justify-content:space-between; margin:0 8px; font-size:11px;\">\n        <span>0</span><span>2</span><span>4</span><span>6</span>\n        <span>7</span><span>8</span><span>10</span><span>12</span><span>14</span>\n    </div>\n    <div style=\"display:flex; justify-content:space-between; margin:2px 8px; font-size:11px;\">\n        <span>Ácido</span><span>Neutro</span><span>Alcalino</span>\n    </div>\n</div>",
